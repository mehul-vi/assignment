# Server Port
PORT=5000

# LLM Provider Keys (Groq / Google Gemini)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-qdrant-cluster-url.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=employee_handbook

# Primary Reference PDF URL
PDF_URL=https://raw.githubusercontent.com/Azure-Samples/azure-search-openai-demo/main/data/employee_handbook.pdf
